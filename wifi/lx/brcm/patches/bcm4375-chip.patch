+static u32 brcmf_pcie_buscore_read32(void *ctx, u32 addr);
+static void brcmf_pcie_buscore_write32(void *ctx, u32 addr, u32 value);
+
+/* The PMU's resource limit and ChipCommon's fast clock (HT) before the ARM runs:
+ * the BCM4375's firmware as left by the boot chain never gets HT otherwise.
+ */
+#define BRCMF_PMU_CAPABILITIES		0x604
+#define BRCMF_PMU_MAX_RES_MASK		0x61c
+#define BRCMF_CLK_CTL_ST		0x1e0
+#define BRCMF_CCS_FORCEHT		0x2
+#define BRCMF_CCS_HTAVAIL		0x20000
+
+static void brcmf_pcie_4375_clocks(struct brcmf_pciedev_info *devinfo)
+{
+	struct brcmf_bus *bus = dev_get_drvdata(&devinfo->pdev->dev);
+	struct brcmf_core *pmu = brcmf_chip_get_pmu(devinfo->ci);
+	struct brcmf_core *cc = brcmf_chip_get_chipcommon(devinfo->ci);
+	u32 count, mask, i;
+
+	count = (brcmf_pcie_buscore_read32(devinfo, pmu->base +
+					   BRCMF_PMU_CAPABILITIES) >> 8) & 0x1f;
+	mask = count >= 31 ? 0x7fffffff : (1u << count) - 1;
+	brcmf_pcie_buscore_write32(devinfo, pmu->base + BRCMF_PMU_MAX_RES_MASK,
+				   mask);
+	msleep(10);
+	brcmf_pcie_buscore_write32(devinfo, cc->base + BRCMF_CLK_CTL_ST,
+				   brcmf_pcie_buscore_read32(devinfo, cc->base +
+							     BRCMF_CLK_CTL_ST) |
+				   BRCMF_CCS_FORCEHT);
+	for (i = 0; i < 100; i++) {
+		if (brcmf_pcie_buscore_read32(devinfo, cc->base +
+					      BRCMF_CLK_CTL_ST) &
+		    BRCMF_CCS_HTAVAIL)
+			break;
+		usleep_range(1000, 2000);
+	}
+	brcmf_err(bus, "BCM4375: max_res_mask %#x, clk_ctl_st %#x\n",
+		  brcmf_pcie_buscore_read32(devinfo, pmu->base +
+					    BRCMF_PMU_MAX_RES_MASK),
+		  brcmf_pcie_buscore_read32(devinfo, cc->base +
+					    BRCMF_CLK_CTL_ST));
+}
